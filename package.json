{
  "name": "typescript-playwright-cruise-search-e2e",
  "version": "1.0.0",
  "description": "Domain-focused Playwright E2E sample: data-driven cruise search (complements qa-playwright-ai-framework).",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
